:root{

--bg:#111827;
--card:#1f2937;
--primary:#3b82f6;
--primary-hover:#2563eb;
--text:#f3f4f6;
--gray:#9ca3af;

}

*{

margin:0;
padding:0;
box-sizing:border-box;

}

body{

font-family:Arial, Helvetica, sans-serif;

background:var(--bg);

color:var(--text);

display:flex;

justify-content:center;

align-items:center;

min-height:100vh;

padding:20px;

}

.container{

background:var(--card);

padding:40px;

border-radius:15px;

width:400px;

text-align:center;

}

h1{

margin-bottom:20px;

}

p{

margin-bottom:25px;

color:var(--gray);

}

input{

width:100%;

padding:15px;

margin-bottom:20px;

border:2px solid #374151;

background:#111827;

color:white;

border-radius:8px;

outline:none;

transition:.3s;

}

/* Pseudo-class */

input:focus{

border-color:var(--primary);

box-shadow:0 0 12px rgba(59,130,246,.5);

}

.btn{

width:100%;

padding:15px;

border:none;

background:var(--primary);

color:white;

font-size:16px;

cursor:pointer;

border-radius:8px;

transition:.3s;

}

.btn:hover{

background:var(--primary-hover);

transform:translateY(-4px);

}

.btn:active{

transform:scale(.96);

}

ul{

margin:30px 0;

text-align:left;

}

li{

margin:10px 0;

}

li:first-child{

color:#22c55e;

}

li:last-child{

color:#f59e0b;

font-weight:bold;

}

a{

color:#60a5fa;

text-decoration:none;

transition:.3s;

}

a:hover{

color:white;

}

a:visited{

color:#c084fc;

}

@media(max-width:500px){

.container{

width:100%;

padding:25px;

}

h1{

font-size:28px;

}

}
