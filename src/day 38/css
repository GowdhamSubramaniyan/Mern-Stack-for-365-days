

footer{

    background:#3f51b5;

    color:white;

    text-align:center;

    padding:40px;

    margin-top:60px;

}

footer h3{

    margin-bottom:10px;

    font-size:2rem;

}

footer p{

    margin-bottom:20px;

    line-height:1.6;

}

.footer-links{

    margin:30px 0;

}

.footer-links a{

    color:white;

    text-decoration:none;

    margin:0 15px;

    font-weight:bold;

}

.footer-links a:hover{

    color:yellow;

}

.copyright{

    border-top:1px solid rgba(255,255,255,0.3);

    padding-top:20px;

    margin-top:30px;

}
