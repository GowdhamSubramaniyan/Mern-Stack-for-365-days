/* Reset */

body{

    margin:0;

    font-family:Arial, Helvetica, sans-serif;

    background:#f5f7fa;

    color:#333;

}

/* Header */

header{

    background:#1e3a8a;

    border-bottom:5px solid #2563eb;

}

/* Header Container */

.header-container{

    width:90%;

    margin:auto;

    padding:20px;

    text-align:center;

}

/* Logo */

.logo{

    color:white;

    font-size:2.5rem;

    margin-bottom:20px;

}

/* Navigation */

nav a{

    display:inline-block;

    color:white;

    text-decoration:none;

    margin:10px;

    padding:12px 20px;

    border:2px solid transparent;

    border-radius:8px;

    transition:0.3s;

}

/* Hover */

nav a:hover{

    background:white;

    color:#1e3a8a;

    border:2px solid white;

}

/* Hero */

.hero{

    text-align:center;

    padding:100px 20px;

}

.hero h2{

    font-size:3rem;

    color:#1e3a8a;

}

.hero p{

    width:60%;

    margin:20px auto;

    line-height:1.8;

}

/* Button */

.btn{

    display:inline-block;

    margin-top:20px;

    background:#1e3a8a;

    color:white;

    text-decoration:none;

    padding:15px 30px;

    border-radius:8px;

}

.btn:hover{

    background:#2563eb;

}

/* Footer */

footer{

    margin-top:80px;

    background:#1e3a8a;

    color:white;

    text-align:center;

    padding:30px;

}
