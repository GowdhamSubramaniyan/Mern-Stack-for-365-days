*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:Arial,Helvetica,sans-serif;

    display:flex;

    justify-content:center;

    align-items:center;

    min-height:100vh;

    background:#0f172a;

    color:white;

}

.container{

    width:420px;

    padding:40px;

    background:#1e293b;

    border-radius:15px;

    text-align:center;

}

button{

    margin-top:25px;

    padding:15px 30px;

    border:none;

    background:#2563eb;

    color:white;

    cursor:pointer;

    border-radius:8px;

    font-size:18px;

    transition:.3s;

}

button:hover{

    background:#1d4ed8;

}
