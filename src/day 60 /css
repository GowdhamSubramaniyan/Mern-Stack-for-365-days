*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{

font-family:Arial,Helvetica,sans-serif;

line-height:1.6;

background:#f8f9fb;

color:#222;

}

nav{

display:flex;

justify-content:space-between;

align-items:center;

padding:25px 10%;

background:white;

box-shadow:0 2px 10px rgba(0,0,0,.08);

}

nav ul{

display:flex;

gap:30px;

list-style:none;

}

nav a{

text-decoration:none;

color:#222;

font-weight:bold;

}

.hero{

height:80vh;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

text-align:center;

padding:20px;

}

.hero h1{

font-size:60px;

margin-bottom:20px;

}

.hero p{

max-width:600px;

margin-bottom:30px;

}

.btn{

display:inline-block;

padding:14px 30px;

background:#222;

color:white;

text-decoration:none;

border-radius:8px;

transition:.3s;

}

.btn:hover{

background:#444;

}

section{

padding:80px 10%;

}

.skills{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(150px,1fr));

gap:20px;

margin-top:30px;

}

.skills div{

background:white;

padding:25px;

text-align:center;

border-radius:10px;

box-shadow:0 5px 15px rgba(0,0,0,.08);

}

.cards{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(280px,1fr));

gap:30px;

margin-top:40px;

}

.card{

background:white;

border-radius:12px;

overflow:hidden;

box-shadow:0 10px 20px rgba(0,0,0,.08);

transition:.3s;

}

.card:hover{

transform:translateY(-10px);

}

.card img{

width:100%;

display:block;

}

.card h3{

padding:20px;

}

.card p{

padding:0 20px 20px;

}

footer{

text-align:center;

padding:30px;

background:#222;

color:white;

margin-top:60px;

}

@media(max-width:768px){

nav{

flex-direction:column;

gap:20px;

}

.hero h1{

font-size:42px;

}

}
