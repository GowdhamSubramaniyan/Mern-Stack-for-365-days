

:root{

    --primary-color:#1e3a8a;
    --secondary-color:#2563eb;
    --background-color:#f5f5f5;
    --card-color:#ffffff;
    --text-color:#333333;
    --white:#ffffff;
    --shadow:0 5px 15px rgba(0,0,0,.15);

}



*{

    margin:0;
    padding:0;
    box-sizing:border-box;

}



body{

    font-family:Arial, Helvetica, sans-serif;
    background:var(--background-color);
    color:var(--text-color);

}



header{

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:20px 60px;

    background:var(--primary-color);

}

header h1{

    color:var(--white);

}

nav{

    display:flex;
    gap:25px;

}

nav a{

    color:var(--white);

    text-decoration:none;

    transition:.3s;

}

nav a:hover{

    color:#dddddd;

}



.hero{

    text-align:center;

    padding:80px 20px;

}

.hero h2{

    font-size:42px;

    margin-bottom:20px;

}

.hero p{

    margin-bottom:30px;

}



.btn{

    background:var(--primary-color);

    color:var(--white);

    border:none;

    padding:15px 30px;

    border-radius:8px;

    cursor:pointer;

    transition:.3s;

}

.btn:hover{

    background:var(--secondary-color);

    transform:translateY(-3px);

}



.projects{

    width:90%;

    margin:70px auto;

}

.projects h2{

    text-align:center;

    margin-bottom:40px;

}

.project-grid{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:25px;

}



.card{

    background:var(--card-color);

    padding:30px;

    border-radius:10px;

    box-shadow:var(--shadow);

    transition:.3s;

}

.card:hover{

    transform:translateY(-8px);

}

.card h3{

    margin-bottom:15px;

}



footer{

    text-align:center;

    background:var(--primary-color);

    color:var(--white);

    padding:25px;

    margin-top:60px;

}



@media(max-width:768px){

header{

    flex-direction:column;

    gap:20px;

    text-align:center;

}

nav{

    flex-direction:column;

    align-items:center;

}

.hero h2{

    font-size:30px;

}

.project-grid{

    grid-template-columns:1fr;

}


}
