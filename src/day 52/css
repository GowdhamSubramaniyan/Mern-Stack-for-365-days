


:root{

    --primary:#ff4d6d;
    --secondary:#ff758f;
    --background:#fff0f5;
    --white:#ffffff;
    --text:#333;
    --shadow:0 15px 30px rgba(0,0,0,.15);

}




*{

    margin:0;
    padding:0;
    box-sizing:border-box;

}




body{

    font-family:Arial, Helvetica, sans-serif;

    background:linear-gradient(135deg,#ffe6eb,#fff8fa);

    display:flex;

    justify-content:center;

    align-items:center;

    min-height:100vh;

}




.container{

    padding:20px;

}




.card{

    background:var(--white);

    padding:40px;

    border-radius:20px;

    width:380px;

    text-align:center;

    box-shadow:var(--shadow);

    animation:fadeUp 1s ease;

    transition:.4s ease;

}

.card:hover{

    transform:translateY(-10px);

    box-shadow:0 25px 40px rgba(0,0,0,.25);

}




.heart{

    font-size:70px;

    animation:heartbeat 1.5s infinite;

}




h1{

    margin:20px 0;

    color:var(--primary);

}




p{

    color:var(--text);

    line-height:1.8;

    margin-bottom:30px;

}




button{

    padding:15px 35px;

    border:none;

    border-radius:50px;

    background:var(--primary);

    color:white;

    font-size:16px;

    cursor:pointer;

    transition:.3s ease;

}

button:hover{

    background:var(--secondary);

    transform:scale(1.08);

}



@keyframes heartbeat{

0%{

transform:scale(1);

}

50%{

transform:scale(1.25);

}

100%{

transform:scale(1);

}

}

@keyframes fadeUp{

from{

opacity:0;

transform:translateY(50px);

}

to{

opacity:1;

transform:translateY(0);

}

}




@media(max-width:500px){

.card{

width:100%;

padding:30px 20px;

}

h1{

font-size:28px;

}

p{

font-size:15px;

}

button{

width:100%;

}

}
