body{
    font-family: Arial, sans-serif;
    background:#f5f5f5;
    margin:0;
}

.projects{
    width:90%;
    margin:80px auto;
    text-align:center;
}

.projects h2{
    font-size:2.5rem;
    color:#1e3a8a;
    margin-bottom:40px;
}

.projects-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

.card{
    background:white;
    padding:30px;
    border-radius:12px;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
    transition:0.5s;
}

.card:hover{
    transform:translateY(-8px);
}

.card h3{
    color:#1e3a8a;
    margin-bottom:15px;
}

.card p{
    color:#555;
    line-height:1.7;
}
