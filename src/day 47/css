/* ===========================
   CSS VARIABLES
=========================== */

:root{

    --primary:#1e3a8a;

    --secondary:#2563eb;

    --background:#f5f5f5;

    --white:#ffffff;

    --text:#333333;

}

/* ===========================
   RESET
=========================== */

*{

    margin:0;

    padding:0;

    box-sizing:border-box;

}

/* ===========================
   BODY
=========================== */

body{

    font-family:Arial, Helvetica, sans-serif;

    background:var(--background);

    color:var(--text);

}

/* ===========================
   HEADER
=========================== */

header{

    background:var(--primary);

    color:var(--white);

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:20px 60px;

}

nav{

    display:flex;

    gap:20px;

}

nav a{

    color:var(--white);

    text-decoration:none;

}

nav a:hover{

    color:#dddddd;

}

/* ===========================
   HERO
=========================== */

.hero{

    text-align:center;

    padding:80px 20px;

}

.hero h2{

    font-size:40px;

    margin-bottom:20px;

}

.hero p{

    font-size:18px;

    margin-bottom:30px;

}

/* ===========================
   BUTTON
=========================== */

.btn{

    background:var(--primary);

    color:var(--white);

    border:none;

    padding:15px 30px;

    border-radius:8px;

    cursor:pointer;

    font-size:16px;

}

.btn:hover{

    background:var(--secondary);

}

/* ===========================
   PROJECTS
=========================== */

.projects{

    width:90%;

    margin:60px auto;

}

.projects h2{

    text-align:center;

    margin-bottom:40px;

}

/* ===========================
   GRID
=========================== */

.project-grid{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:30px;

}

/* ===========================
   CARD
=========================== */

.card{

    background:var(--white);

    padding:30px;

    border-radius:10px;

    box-shadow:0 5px 15px rgba(0,0,0,.15);

    position:relative;

}

.card h3{

    margin-bottom:15px;

}

/* ===========================
   BADGE
=========================== */

.badge{

    position:absolute;

    top:15px;

    right:15px;

    background:red;

    color:white;

    padding:6px 12px;

    border-radius:20px;

    font-size:12px;

    font-weight:bold;

}
