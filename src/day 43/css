/* Reset */

body{
    margin:0;
    font-family:Arial, Helvetica, sans-serif;
    background:#f5f7fa;
    color:#333;
}

/* Header */

header{
    background:#1e3a8a;
    padding:20px 50px;
}

.navbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    color:white;
    margin:0;
}

nav{
    display:flex;
    gap:20px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

nav a:hover{
    color:#ffd700;
}

/* Hero */

.hero{
    width:90%;
    margin:60px auto;

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:50px;
}

.hero-text{
    flex:1;
}

.hero-text h1{
    font-size:3rem;
    color:#1e3a8a;
}

.hero-text p{
    line-height:1.8;
    margin:20px 0;
}

.hero-image{
    flex:1;
    text-align:center;
}

.hero-image img{
    width:300px;
    border-radius:15px;
}

/* Button */

.btn{
    display:inline-block;
    background:#1e3a8a;
    color:white;
    text-decoration:none;
    padding:15px 30px;
    border-radius:8px;
}

.btn:hover{
    background:#2563eb;
}

/* Footer */

footer{
    margin-top:80px;
    background:#1e3a8a;
    color:white;
    text-align:center;
    padding:30px;
}
