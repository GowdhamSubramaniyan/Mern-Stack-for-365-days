body{
    margin:0;
    background:#eef2ff;
    font-family:Arial, Helvetica, sans-serif;
}

.container{
    width:70%;
    margin:50px auto;
    background:white;
    padding:40px;
    border-radius:15px;
    text-align:center;
}

h1{
    color:#3f51b5;
}

h2{
    color:#333;
}

p{
    color:#555;
    line-height:1.6;
}

ul{
    display:inline-block;
    text-align:left;
}

li{
    margin:10px 0;
}
